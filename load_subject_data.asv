function [H_matrices, activity_names, raw_emg_data] = load_subject_data(subject_id, condition_id, data_folder)
    % Load and process EMG activity data for a given subject and condition
    % subject_id: string (e.g., '01')
    % condition_id: string ('01' or '02')
    % data_folder: main dataset folder (e.g., 'ICCOR_2025_sEMG_Data')
    
    num_activities = 8; % Total number of activity files
    num_synergies = 3; % Number of synergies to extract
    muscle_labels = {'BB', 'PD', 'AD', 'MD', 'TL', 'WF', 'WE', 'BR'};
    
    % Path to subject's data folder
    subject_path = fullfile(data_folder, subject_id, condition_id);
    
    % Preallocate storage
    H_matrices = cell(num_activities, 1);
    activity_names = cell(num_activities, 1);
    raw_emg_data = cell(num_activities, 1); % Store original EMG time-series data
    
    % Loop through all 8 activities
    for act = 1:num_activities
        filename = fullfile(subject_path, sprintf('processed-emg-%02d.csv', act));
        
        if exist(filename, 'file')
            temp_data = readmatrix(filename);
            temp_data(1, :) = []; % Remove first row (headers)
            
            % Extract the muscle channels (ensure consistent ordering)
            BB = temp_data(:, 5);  % Biceps Brachii
            PD = temp_data(:, 6);  % Posterior Deltoid
            AD = temp_data(:, 7);  % Anterior Deltoid
            MD = temp_data(:, 8);  % Middle Deltoid
            TL = temp_data(:, 9);  % Triceps Long-head
            WF = temp_data(:, 10); % Wrist Flexors
            WE = temp_data(:, 11); % Wrist Extensors
            BR = temp_data(:, 12); % Brachioradialis
            
            emg_data = [BB, PD, AD, MD, TL, WF, WE, BR]; % Combine into matrix
            
            % Store raw EMG data for later distribution plotting
            raw_emg_data{act} = emg_data;
            
            % Perform NNMF
            rng default % For reproducibility
            A = rand(numel(,num_synergies)*rand(num_synergies,numel(emg_data));
            opt = statset('MaxIter',10,'Display','final');
            [W0,H0] = nnmf(A, num_synergies, 'replicates',5, 'options', opt, 'algorithm', 'mult');
            opt = statset('Maxiter',1000,'Display','final');
            [W,H] = nnmf(emg_data, num_synergies, 'w0', W0, 'h0', H0, 'options', opt, 'algorithm', 'als');
            
            % Store NNMF results
            H_matrices{act} = H;
            activity_names{act} = sprintf('Activity %d', act);
        else
            warning('File %s not found. Skipping...', filename);
        end
    end
end
